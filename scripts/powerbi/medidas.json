{
  "tabelas": {
    "Medidas": "ROW ( \"oculta\", BLANK () )",
    "dim_nivel": "DISTINCT (\n    UNION (\n        SELECTCOLUMNS ( fato_trecho, \"nivel\", fato_trecho[nivel] ),\n        SELECTCOLUMNS ( fato_abate, \"nivel\", fato_abate[nivel] ),\n        SELECTCOLUMNS ( FILTER ( fato_consumo, NOT ISBLANK ( fato_consumo[nivel] ) ), \"nivel\", fato_consumo[nivel] )\n    )\n)",
    "Componentes Lucro": "DATATABLE ( \"Componente\", STRING, \"Ordem\", INTEGER, { { \"Gold dos abates\", 1 }, { \"Vendas auto\", 2 }, { \"Drops\", 3 }, { \"Bolas\", 4 }, { \"Poções e revives\", 5 } } )"
  },
  "relacionamentos": [
    {
      "de": "dim_hunt",
      "coluna": "hunt_id",
      "fatos": ["fato_sessao", "fato_trecho", "fato_abate", "fato_consumo", "fato_drop"]
    },
    {
      "de": "dim_nivel",
      "coluna": "nivel",
      "fatos": ["fato_trecho", "fato_abate", "fato_consumo"]
    }
  ],
  "medidas": [
    {
