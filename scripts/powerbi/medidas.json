      "formato": "#,0"
    },
    {
      "pasta": "Nível",
      "nome": "XP/h Nível",
      "expressao": "DIVIDE ( SUM ( fato_trecho[xp_pokemon] ), [Horas Trecho] )",
      "formato": "#,0"
    },
    {
      "pasta": "Nível",
      "nome": "Gold/h Nível",
      "expressao": "DIVIDE ( SUM ( fato_trecho[gold] ), [Horas Trecho] )",
      "formato": "#,0"
    },
