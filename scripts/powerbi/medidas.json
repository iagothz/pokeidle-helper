      "formato": "#,0"
    },
    {
      "pasta": "Nível",
      "nome": "Poções/h Nível",
      "expressao": "DIVIDE ( CALCULATE ( COUNTROWS ( fato_consumo ), fato_consumo[tipo] = \"pocao\" ), [Horas Trecho] )",
      "formato": "#,0.00"
    },
    {
      "pasta": "Nível",
      "nome": "Abates (registros)",
      "expressao": "COUNTROWS ( fato_abate )",
      "formato": "#,0"
    },
    {
      "pasta": "Fases",
      "nome": "Fases ms",
      "expressao": "SUM ( fato_sessao[luta_ms] ) + SUM ( fato_sessao[deslocamento_ms] ) + SUM ( fato_sessao[espera_ms] )",
      "formato": "#,0"
    },
    {
      "pasta": "Fases",
      "nome": "% Luta",
      "expressao": "DIVIDE ( SUM ( fato_sessao[luta_ms] ), [Fases ms] )",
      "formato": "0.0%"
    },
    {
      "pasta": "Fases",
      "nome": "% Deslocamento",
      "expressao": "DIVIDE ( SUM ( fato_sessao[deslocamento_ms] ), [Fases ms] )",
      "formato": "0.0%"
    },
    {
      "pasta": "Fases",
      "nome": "% Espera",
      "expressao": "DIVIDE ( SUM ( fato_sessao[espera_ms] ), [Fases ms] )",
      "formato": "0.0%"
    },
    {
      "pasta": "Fases",
      "nome": "Fases ms Trecho",
      "expressao": "SUM ( fato_trecho[luta_ms] ) + SUM ( fato_trecho[deslocamento_ms] ) + SUM ( fato_trecho[espera_ms] )",
      "formato": "#,0"
    },
    {
      "pasta": "Fases",
      "nome": "% Luta Nível",
      "expressao": "DIVIDE ( SUM ( fato_trecho[luta_ms] ), [Fases ms Trecho] )",
      "formato": "0.0%"
    },
    {
      "pasta": "Fases",
      "nome": "% Deslocamento Nível",
      "expressao": "DIVIDE ( SUM ( fato_trecho[deslocamento_ms] ), [Fases ms Trecho] )",
      "formato": "0.0%"
    },
    {
      "pasta": "Fases",
      "nome": "% Espera Nível",
      "expressao": "DIVIDE ( SUM ( fato_trecho[espera_ms] ), [Fases ms Trecho] )",
      "formato": "0.0%"
    },
    {
      "pasta": "Fases",
      "nome": "Segundos de Deslocamento por Onda",
      "expressao": "DIVIDE ( SUM ( fato_sessao[deslocamento_ms] ), SUM ( fato_sessao[ondas] ) ) / 1000",
      "formato": "#,0.00"
    },
    {
      "pasta": "Fases",
      "nome": "XP/h (só com fases)",
      "expressao": "CALCULATE ( [XP/h], dim_sessao[fases_medidas] = TRUE () )",
      "formato": "#,0"
    },
    {
      "pasta": "Captura",
      "nome": "Taxa de Captura",
      "expressao": "DIVIDE ( [Capturas], [Bolas Usadas] )",
      "formato": "0.00%"
    },
    {
      "pasta": "Captura",
      "nome": "Bolas por Captura",
      "expressao": "DIVIDE ( [Bolas Usadas], [Capturas] )",
      "formato": "#,0.00"
    },
    {
      "pasta": "Captura",
      "nome": "Custo por Captura",
      "expressao": "DIVIDE ( [Custo Bolas], [Capturas] )",
      "formato": "#,0"
    },
    {
      "pasta": "Captura",
      "nome": "Venda Média por Captura",
      "expressao": "CALCULATE ( AVERAGE ( fato_consumo[valor_venda_auto] ), fato_consumo[tipo] = \"captura\", fato_consumo[valor_venda_auto] > 0 )",
      "formato": "#,0"
    },
    {
      "pasta": "Captura",
      "nome": "Saldo Autocatch",
      "expressao": "[Vendas Auto] - [Custo Bolas]",
      "formato": "#,0"
    },
    {
      "pasta": "Captura",
      "nome": "Saldo Autocatch/h",
      "expressao": "DIVIDE ( [Saldo Autocatch], [Horas Ativas] )",
      "formato": "#,0"
    },
    {
      "pasta": "Captura",
      "nome": "Capturas (eventos)",
      "expressao": "CALCULATE ( COUNTROWS ( fato_consumo ), fato_consumo[tipo] = \"captura\" )",
      "formato": "#,0"
    },
    {
      "pasta": "Captura",
      "nome": "Bolas (eventos)",
      "expressao": "CALCULATE ( COUNTROWS ( fato_consumo ), fato_consumo[tipo] = \"bola\" )",
      "formato": "#,0"
    },
    {
      "pasta": "Captura",
      "nome": "Taxa de Captura (eventos)",
      "expressao": "DIVIDE ( [Capturas (eventos)], [Bolas (eventos)] )",
      "formato": "0.00%"
    },
    {
      "pasta": "Captura",
      "nome": "Saldo Autocatch Acumulado",
      "expressao": "VAR ate = MAX ( fato_consumo[momento] )\nRETURN\n    CALCULATE (\n        SUM ( fato_consumo[valor_venda_auto] ) - SUM ( fato_consumo[custo] ),\n        fato_consumo[tipo] IN { \"captura\", \"bola\" },\n        fato_consumo[momento] <= ate,\n        REMOVEFILTERS ( fato_consumo[momento] )\n    )",
      "formato": "#,0"
    },
    {
      "pasta": "Lucro",
      "nome": "Valor Componente",
      "expressao": "SWITCH (\n    SELECTEDVALUE ( 'Componentes Lucro'[Componente] ),\n    \"Gold dos abates\", [Gold Abates],\n    \"Vendas auto\", [Vendas Auto],\n    \"Drops\", [Valor Drops],\n    \"Bolas\", - [Custo Bolas],\n    \"Poções e revives\", - [Custo Poções]\n)",
      "formato": "#,0"
    }
  ]
}
