      "expressao": "DIVIDE ( SUM ( fato_trecho[ms_ativo] ), 60000 )",
      "formato": "#,0.00"
    },
    {
      "pasta": "Nível",
      "nome": "Duração Média do Abate (s)",
      "expressao": "DIVIDE ( AVERAGE ( fato_abate[duracao_ms] ), 1000 )",
      "formato": "#,0.00"
    },
    {
